<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MSTest" Version="4.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SharpOnvifClient\SharpOnvifClient.csproj" />
    <ProjectReference Include="..\SharpOnvifCommon\SharpOnvifCommon.csproj" />
    <ProjectReference Include="..\SharpOnvifServer\SharpOnvifServer.csproj" />
    <ProjectReference Include="..\WsdlGenerator\WsdlGenerator.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- A small WSDL that is not Onvif, for testing the generator against something else. -->
    <None Include="Wsdl\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

</Project>
