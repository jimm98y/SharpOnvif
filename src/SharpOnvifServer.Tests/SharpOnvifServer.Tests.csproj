<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <!-- The three test assemblies share one namespace on purpose: TestNamespaceCoexistence has
         to compile as a consumer does, from outside the product namespaces. -->
    <RootNamespace>SharpOnvif.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MSTest" Version="4.4.0" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SharpOnvifServer\SharpOnvifServer.csproj" />
    <!-- The end-to-end tests answer the server with the real client rather than a hand-built
         request, which is what makes them worth having. -->
    <ProjectReference Include="..\SharpOnvifClient\SharpOnvifClient.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

</Project>

