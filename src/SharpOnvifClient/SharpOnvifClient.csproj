<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>netstandard2.0;net481;net8.0;net10.0</TargetFrameworks>
	</PropertyGroup>

	<!-- No reflection: the contracts' serialization, and the server's dispatch, are generated. The trim and AOT
	     analyzers check that it stays so, where they exist. -->
	<PropertyGroup Condition=" $([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0')) ">
		<IsAotCompatible>true</IsAotCompatible>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\SharpOnvifCommon\SharpOnvifCommon.csproj" />
	</ItemGroup>

	<ItemGroup Condition=" $(TargetFramework.StartsWith('net4')) ">
		<Reference Include="System.Net.Http" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="SharpOnvifClient.Tests" />
	</ItemGroup>

	<!-- the public API: listed in PublicAPI.*.txt, and checked against the last release (doc/public-api.md) -->
	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" PrivateAssets="all" />
	</ItemGroup>

	<PropertyGroup>
		<!-- a symbol gone from the API fails the build; one added warns, until listed: an addition breaks no one -->
		<WarningsAsErrors>$(WarningsAsErrors);RS0017</WarningsAsErrors>
		<!-- overloads with optional parameters are a style choice here, not a break -->
		<NoWarn>$(NoWarn);RS0026;RS0027</NoWarn>
		<EnablePackageValidation>true</EnablePackageValidation>
		<PackageValidationBaselineVersion>0.11.4</PackageValidationBaselineVersion>
	</PropertyGroup>

</Project>