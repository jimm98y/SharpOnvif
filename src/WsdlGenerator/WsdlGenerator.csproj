<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<RootNamespace>WsdlGenerator</RootNamespace>
		<IsPackable>false</IsPackable>
		<GeneratePackageOnBuild>false</GeneratePackageOnBuild>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
	</PropertyGroup>

	<ItemGroup>
		<!-- The generator is exercised by the test project, which drives its internals directly. -->
		<InternalsVisibleTo Include="SharpOnvifCommon.Tests" />
	</ItemGroup>

	<ItemGroup>
		<!--
			The runtime under Runtime/ is source the generator writes out, not source it is built
			from: it is carried along as a resource and emitted into the namespace a run chooses.
			It stays valid C# so an editor still checks it, which is why the namespace it is
			written in is a plain identifier.
		-->
		<Compile Remove="Runtime/**/*.cs" />
		<EmbeddedResource Include="Runtime/**/*.cs" />
	</ItemGroup>

</Project>
